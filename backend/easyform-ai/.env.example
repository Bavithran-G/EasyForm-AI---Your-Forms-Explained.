# Copy to `.env` and fill in.
# The app runs without a key (grounded extractive fallback + retrieval evaluation still work),
# but the LLM simplification and follow-ups need one.

GROQ_API_KEY="your_groq_api_key_here"
# OPENAI_API_KEY="your_openai_api_key_here"   # optional, only if not using Groq
OPENAI_MODEL=openai/gpt-oss-120b
EASYFORM_DISABLE_ST=1
EASYFORM_DISABLE_RERANK=1

# Optional overrides
# EASYFORM_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EASYFORM_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# EASYFORM_MAX_MB=25           # per-file upload cap
# LOG_LEVEL=INFO
# PORT=8000
# HOST=0.0.0.0
# EASYFORM_CORS_ORIGINS=http://localhost:5173



